# Mapbox API Token
# Get your token from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# NASA API Key (optional)
# Get your key from: https://api.nasa.gov/
NASA_API_KEY=your_nasa_api_key_here

# N2YO API Key for satellite tracking (optional)
# Get your key from: https://www.n2yo.com/api/
N2YO_API_KEY=your_n2yo_api_key_here

# OpenWeather API Key (optional)
# Get your key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Default observer location, shown until browser geolocation succeeds (or if it is denied).
# Defaults to Bangalore (12.9716, 77.5946) if unset. Baked in at build time.
# NEXT_PUBLIC_DEFAULT_LAT=12.9716
# NEXT_PUBLIC_DEFAULT_LON=77.5946
